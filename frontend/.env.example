# Port of the backend API server.
# Used for automatic API URL inference based on current hostname
# (e.g. visiting business.localhost:5173 sends requests to business.localhost:5000/api).
VITE_API_PORT=5000

# Root domain matching backend's APP_DOMAIN.
# Local dev: localhost
# Production: pos.com
VITE_APP_DOMAIN=localhost

# Subdomain reserved for the Platform Admin portal.
# Must match PLATFORM_SUBDOMAIN in backend/.env.
# Local dev: http://deeplexica.localhost:5173/platform/login
# Production: https://deeplexica.pos.com/platform/login
VITE_PLATFORM_SUBDOMAIN=deeplexica

# Optional: Only set this if you want to force a fixed API URL and bypass hostname inference.
# VITE_API_BASE_URL=http://localhost:5000/api
