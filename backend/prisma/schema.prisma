
// =====================================================
// POS & INVENTORY MANAGEMENT SYSTEM - DATABASE SCHEMA
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

// UomType used to be a fixed enum (BOX/SQ_FT/SQ_M/LENGTH/BUNDLE/PIECE) --
// six values chosen for tiles/pipes specifically, hardcoding this app to
// one retail vertical. Replaced by the UnitOfMeasure model below, which
// is business-managed exactly like Role became dynamic earlier -- a new
// business gets a small starter list (Piece, Box, Kg, Liter, Meter,
// Dozen -- see seed.js) they can freely rename, add to, or remove,
// instead of a fixed list compiled into the schema.

enum MovementType {
  STOCK_IN
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  VOID_REVERSAL
}

// Describes what kind of thing a business-managed UnitOfMeasure actually
// measures. Units are dynamic (an admin can create "Carton", "Bundle",
// anything) so the app cannot infer this from a unit's name -- it must be
// chosen explicitly when the unit is created. COUNT is the default for a
// freshly created unit (a whole, discrete, countable thing). AREA is what
// gates which units are selectable in a product's optional coverage rule
// below (see Product.coverage_uom_id) -- e.g. "Square Metre"/"Square
// Foot", never a count/weight/volume/length unit.
enum MeasurementType {
  COUNT
  AREA
  LENGTH
  WEIGHT
  VOLUME
  OTHER
}

enum InvoiceStatus {
  COMPLETED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CREDIT
}

enum PurchaseOrderStatus {
  DRAFT
  PARTIALLY_RECEIVED
  RECEIVED
}

enum CustomerType {
  RETAIL
  WHOLESALE
  CONTRACTOR
}

enum PaidStatus {
  PENDING
  PAID
}

// PERCENTAGE: discount_value is a % off (e.g. 5 = 5% off).
// FLAT: discount_value is a flat currency amount off, per unit.
enum DiscountType {
  PERCENTAGE
  FLAT
}

// =====================================================
// PLATFORM / SUPER ADMIN
// =====================================================
// Everything above this point is tenant-scoped data — every model listed
// below belongs to exactly one Business via business_id, enforced both
// by the FK here and, at the application layer, by the tenant-scoping
// Prisma extension (see backend/src/config/db.js) which auto-injects
// `business_id` into every query for these models based on the
// logged-in user's business — no individual service file needs to
// remember to filter by it manually.
//
// Business and the two models below it (PlatformAdmin,
// PlatformAuditLog) are the ONLY models NOT scoped this way — they're
// platform-level, managed exclusively through /api/platform/* routes,
// authenticated by a completely separate token type that never carries
// a business_id (see backend/src/middleware/platformAuthMiddleware.js).

enum BusinessStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

// One row per client. Created only by a PlatformAdmin (see
// business.service.js#createBusiness), which also creates that
// business's first user (is_primary_admin=true, see User model) in the
// same transaction — nothing about onboarding a business happens
// outside this one flow.
model Business {
  id              String          @id @default(uuid())
  name            String
  // Not used for real subdomain routing yet (single-deployment demo
  // stage) — kept for display/reference now, and so subdomain-based
  // tenant resolution can be added later without a schema change.
  slug            String          @unique
  status          BusinessStatus  @default(TRIAL)
  industry_type   String?         @map("industry_type")
  contact_email   String?         @map("contact_email")
  contact_phone   String?         @map("contact_phone")
  // Which sidebar sections/API modules this business has access to at
  // all, independent of any individual staff member's role permissions
  // — see moduleMiddleware.js. Business.enabled_modules is checked
  // BEFORE role-based permission checks; a module absent here is
  // invisible and unreachable regardless of role. Values are the same
  // group names already used in config/permissions.js (PRODUCTS,
  // INVENTORY, CONTACTS, SALES, ADMIN, EXPENSES, PAYROLL, ...) — see
  // config/modules.js for the canonical list.
  enabled_modules String[]        @map("enabled_modules")
  max_admin_seats Int?            @map("max_admin_seats")
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  userRows  User[]
  roleRows  Role[]
  rolePermissionRows  RolePermission[]
  userPermissionRows  UserPermission[]
  auditLogRows  AuditLog[]
  categoryRows  Category[]
  productRows  Product[]
  productVariantRows  ProductVariant[]
  productVariantValueRows  ProductVariantValue[]
  variationRows  Variation[]
  variationValueRows  VariationValue[]
  unitOfMeasureRows  UnitOfMeasure[]
  productVariationAxisRows  ProductVariationAxis[]
  kitRows  Kit[]
  kitComponentRows  KitComponent[]
  warehouseRows  Warehouse[]
  batchRows  Batch[]
  costLotRows  CostLot[]
  stockLevelRows  StockLevel[]
  stockMovementRows  StockMovement[]
  stockTransferRows  StockTransfer[]
  customerRows  Customer[]
  customerLedgerEntryRows  CustomerLedgerEntry[]
  invoiceRows  Invoice[]
  invoiceItemRows  InvoiceItem[]
  paymentRows  Payment[]
  installmentPlanRows  InstallmentPlan[]
  installmentPaymentRows  InstallmentPayment[]
  supplierRows  Supplier[]
  supplierLedgerEntryRows  SupplierLedgerEntry[]
  purchaseOrderRows  PurchaseOrder[]
  purchaseOrderItemRows  PurchaseOrderItem[]
  employeeRows  Employee[]
  payrollRecordRows  PayrollRecord[]
  commissionRecordRows  CommissionRecord[]
  expenseBudgetAdjustmentRows  ExpenseBudgetAdjustment[]
  staffExpenseLimitRows  StaffExpenseLimit[]
  staffExpenseRows  StaffExpense[]
  businessSettingsRows  BusinessSettings[]
  expenseBudgetRows  ExpenseBudget[]

  @@map("businesses")
}

// The platform owner's own login(s) — deliberately a separate table
// from User, not a role or flag inside it, so there's zero chance of a
// query that forgets to filter by business_id accidentally returning a
// platform admin mixed into some business's staff list (or vice versa).
model PlatformAdmin {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  audit_logs    PlatformAuditLog[]

  @@map("platform_admins")
}

// Audit trail for platform-level actions only (business suspended,
// plan/module changed, impersonation used, etc.) — separate from the
// per-business AuditLog above, which only ever sees that one business's
// own activity.
model PlatformAuditLog {
  id                String   @id @default(uuid())
  platform_admin_id String   @map("platform_admin_id")
  action            String
  target_business_id String? @map("target_business_id")
  changes           Json?
  created_at        DateTime @default(now())

  platform_admin    PlatformAdmin @relation(fields: [platform_admin_id], references: [id])

  @@map("platform_audit_logs")
}

// =====================================================
// USERS & AUTH
// =====================================================

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password_hash   String
  // Was a fixed `Role` enum (ADMIN/ACCOUNTANT/SALES_STAFF/WAREHOUSE_STAFF).
  // Roles are now fully dynamic — admin-defined rows in the Role table
  // below, with no "built-in" ones baked in — so this is a plain String
  // matching Role.name, with a real FK for integrity. onUpdate: Cascade
  // means renaming a Role automatically updates every user who has it;
  // onDelete: Restrict means a role that still has users assigned can't
  // be deleted out from under them (see roles.service.js, which also
  // checks this before attempting a delete so the error is a friendly
  // 409, not a raw constraint violation).
  //
  // Optional because the primary admin (see is_primary_admin below) is
  // deliberately created with NO role at all — their access doesn't come
  // from a role, so there's nothing to assign.
  role            String?
  // Compound FK — references Role's [business_id, name] compound unique
  // (see Role model below), not just `name` alone, because `name` on
  // its own isn't unique anymore now that roles are per-business (two
  // businesses can each have a role called "Cashier"). Referencing the
  // full compound key isn't just a syntax requirement — it also gets
  // us a real DB-level guarantee that a user's role always belongs to
  // the SAME business as the user, not just an app-level assumption.
  roleRef         Role?    @relation(fields: [business_id, role], references: [business_id, name], onDelete: Restrict, onUpdate: Cascade)
  // The one account (created only by seed.js / a future Super Admin —
  // never through the app itself) whose access can't be taken away.
  // Every other user, "Admin" or not, is an ordinary row with ordinary
  // permissions and can be edited, reassigned, or deactivated by anyone
  // holding USERS_MANAGE. This one can't — see effectivePermissions.js
  // (grants everything, bypassing Role entirely) and users.service.js
  // (blocks edit/deactivate/permission-override on this account from
  // anyone). This guarantees a business can never end up with nobody
  // able to manage its own staff and roles, without needing a special
  // "Owner" tier visible anywhere in the UI — to every other user, this
  // account just looks like an Admin like any other.
  is_primary_admin Boolean @default(false) @map("is_primary_admin")
  is_active       Boolean  @default(true)
  // Profile screen fields — see the Profile module. avatar_url follows
  // the same upload pattern as product images. theme_preference is
  // per-user (each staff member picks their own), not a shared setting.
  avatar_url      String?  @map("avatar_url")
  contact_phone   String?  @map("contact_phone")
  address         String?
  theme_preference ThemePreference @map("theme_preference") @default(LIGHT)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  created_invoices Invoice[] @relation("CreatedByUser")
  employee         Employee?
  audit_logs       AuditLog[]
  login_attempts   LoginAttempt[]
  permission_overrides UserPermission[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("users")
}

enum ThemePreference {
  LIGHT
  DARK
}

// Fully dynamic roles — there is no "built-in" role of any kind. Every
// role, without exception, is created, renamed, re-permissioned, and
// deleted the same way, through the Roles API (see roles.service.js). A
// new role starts with zero permissions; nothing is inherited by
// accident. Nothing in this table or anywhere that reads it is aware of
// a role named "Admin" being special — the one account that genuinely
// can't be locked out (see User.is_primary_admin) is protected at the
// User level instead, not by making any particular Role untouchable.
model Role {
  id          String   @id @default(uuid())
  name        String   
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, name])
  @@index([business_id])
  @@map("roles")
}

// One row per permission a role grants. Deliberately NOT reusing
// UserPermission's granted:true/false shape — a role has no "default" to
// override, so a permission is either present (granted) or simply not a
// row here (not granted). Simpler than tri-state.
model RolePermission {
  id         String @id @default(uuid())
  role_id    String @map("role_id")
  permission String

  role       Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([role_id, permission])
  @@map("role_permissions")
}

// Granular permission overrides on top of a user's role defaults (see
// backend/src/config/permissions.js for the permission list + role
// defaults). granted=true adds a permission the role wouldn't normally
// have; granted=false revokes one the role would normally have.
model UserPermission {
  id         String   @id @default(uuid())
  user_id    String   @map("user_id")
  permission String
  granted    Boolean
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([user_id, permission])
  @@map("user_permissions")
}

model LoginAttempt {
  id          String   @id @default(uuid())
  user_id     String?  @map("user_id")
  email       String
  success     Boolean
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user        User?    @relation(fields: [user_id], references: [id])

  @@map("login_attempts")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String
  action      String
  entity_type String
  entity_id   String
  changes     Json?
  ip_address  String?
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("audit_logs")
}

// =====================================================
// CATALOG
// =====================================================

model Category {
  id          String    @id @default(uuid())
  name        String    
  parent_id   String?   @map("parent_id")
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  parent      Category? @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, name])
  @@index([business_id])
  @@map("categories")
}

model Product {
  id                String    @id @default(uuid())
  name              String
  sku               String    
  category_id       String?   @map("category_id")
  brand             String?
  // Was a fixed enum (BOX/SQ_FT/SQ_M/LENGTH/BUNDLE/PIECE). Now a FK to a
  // business-managed list -- see UnitOfMeasure below.
  base_uom_id       String    @map("base_uom_id")
  // Optional area-coverage rule for this product -- e.g. "1 carton covers
  // 1.44 m2". Replaces the old coverage_per_box/conversion_factor pair,
  // which hard-coded the sale unit to "box" and the area unit to square
  // feet. Both fields are set together or not at all (enforced in
  // products.service.js#validateCoverageFields) -- coverage_uom_id must
  // point at a UnitOfMeasure whose measurement_type is AREA. Distinct
  // from base_uom_id: base_uom_id is what's counted/stocked/sold (e.g.
  // Carton), coverage_uom_id is what one sold unit covers (e.g. Square
  // Metre) -- see AreaCoverageCalculatorModal.jsx in POS.
  coverage_quantity Decimal?        @map("coverage_quantity")
  coverage_uom_id   String?         @map("coverage_uom_id")
  retail_price      Decimal   @map("retail_price")
  wholesale_price   Decimal   @map("wholesale_price")
  cost_price        Decimal   @map("cost_price")
  // Was `hsn_code`, required on every product -- India/Pakistan-specific
  // GST classification, forced even on businesses with no HSN system at
  // all. Renamed and made optional so it's available for the businesses
  // that need it without blocking anyone else from saving a product.
  tax_code          String?   @map("tax_code")
  // Was `gst_rate` -- the % mechanism is universal, only the name was
  // regional. Renamed; behavior unchanged.
  tax_rate          Decimal   @map("tax_rate")
  // Standing discount for this product. Applied as the default on a POS
  // cart line, but always editable per sale (see InvoiceItem.discount_*).
  // Editing tax_rate, these two fields, and target_margin_pct is
  // restricted to the PRICING_MANAGE permission (Admin only by default) —
  // see products.service.js#stripUnauthorizedPricingFields.
  discount_type     DiscountType @map("discount_type") @default(PERCENTAGE)
  discount_value    Decimal   @map("discount_value") @default(0)
  // Target margin as a % of the selling price (not markup on cost) — e.g.
  // 30 means "30% of what the customer pays should be profit". Used only
  // to compute a *suggested* retail/wholesale price after a purchase
  // changes the product's cost; never auto-applied (see purchases.service.js).
  target_margin_pct Decimal?  @map("target_margin_pct")
  is_batch_tracked  Boolean   @map("is_batch_tracked") @default(false)
  // Optional physical dimensions (e.g. a 2ft x 1ft panel). Left null for
  // any product where size isn't a meaningful attribute.
  length            Decimal?  @map("length")
  width             Decimal?  @map("width")
  dimension_unit    String?   @map("dimension_unit")
  reorder_threshold Int       @map("reorder_threshold") @default(5)
  image_url         String?   @map("image_url")
  barcode           String?   
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  category          Category?                @relation(fields: [category_id], references: [id])
  base_uom          UnitOfMeasure            @relation(fields: [base_uom_id], references: [id])
  coverage_uom      UnitOfMeasure?           @relation("CoverageUnit", fields: [coverage_uom_id], references: [id])
  // Which Variations this product uses at all (e.g. both "Color" and
  // "Size") -- see ProductVariationAxis below. Replaces the old single
  // `variation_id` FK, which could only ever point at ONE Variation, so
  // a product could vary by Color OR Size but never both combined into
  // one purchasable item ("Red, Medium").
  variation_axes    ProductVariationAxis[]
  variants          ProductVariant[]
  stock_levels      StockLevel[]
  batches           Batch[]
  stock_movements   StockMovement[]
  kit_components    KitComponent[]           @relation("ComponentProduct")
  invoice_items     InvoiceItem[]
  purchase_items    PurchaseOrderItem[]
  transfers         StockTransfer[]
  cost_lots         CostLot[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, barcode])
  @@unique([business_id, sku])
  @@index([business_id])
  @@map("products")
}

// A business-managed unit of measure -- was a fixed enum (UomType) with
// six values chosen for one retail vertical (tiles/pipes). Now created,
// renamed, and removed the same way Roles are, from Settings.
// `abbreviation` is what's actually shown in tight spaces (POS cart
// lines, receipts) -- e.g. name "Piece", abbreviation "pc".
model UnitOfMeasure {
  id               String          @id @default(uuid())
  name             String
  abbreviation     String
  // What this unit actually measures -- see MeasurementType above. Chosen
  // explicitly by whoever creates the unit (defaults to COUNT), never
  // guessed from its name. Only units with type AREA are selectable as a
  // product's coverage_uom_id (see units.service.js#update, which also
  // locks this field from changing once any product uses the unit either
  // way, so an in-use unit can't silently break existing products).
  measurement_type MeasurementType @default(COUNT)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  products         Product[]
  // Products that use this unit as their optional area-coverage unit
  // (Product.coverage_uom_id) -- separate from `products` above, which is
  // the stock/sale unit (Product.base_uom_id). A unit can appear in both
  // lists at once (nothing stops "Square Metre" from also being sold
  // directly), tracked as two distinct relations since they mean
  // different things.
  coverage_products Product[] @relation("CoverageUnit")

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, name])
  @@index([business_id])
  @@map("units_of_measure")
}

// Which Variations apply to a given product -- e.g. Product "T-Shirt"
// uses both the "Color" and "Size" Variations. This is what drives the
// combination grid in the product form (pick Color + Size -> generate
// Red/S, Red/M, Blue/S, Blue/M...) and is stored explicitly rather than
// inferred from existing ProductVariants, since a product can have this
// set up before any variant combinations are actually added.
model ProductVariationAxis {
  id           String   @id @default(uuid())
  product_id   String   @map("product_id")
  variation_id String   @map("variation_id")

  product      Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variation    Variation @relation(fields: [variation_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([product_id, variation_id])
  @@index([business_id])
  @@map("product_variation_axes")
}

// A specific, real, stocked combination the admin has chosen to sell —
// e.g. "Red, Medium" (linking to BOTH the "Red" VariationValue under
// "Color" AND the "Medium" VariationValue under "Size", via
// ProductVariantValue below). Deliberately NOT auto-generated as stock:
// the admin picks which combinations are actually stocked and adds one
// ProductVariant per real combination — a product can list Color+Size as
// its axes without every theoretical combination existing as a variant.
// A product can be variant-tracked, batch-tracked, both, or neither.
// When both are on for the same product, a Batch is scoped to one
// specific variant (see Batch.variant_id below) — e.g. "Red, Medium,
// Batch B2" — so cost and stock are accurate down to the combination of
// values AND manufacturing lot.
model ProductVariant {
  id                  String    @id @default(uuid())
  product_id          String    @map("product_id")
  sku                 String    
  // Optional override for the rare combination that shouldn't just use
  // the sum of its values' price_adjustments (e.g. a clearance-priced
  // combo). Left null in the normal case — the effective sale price is
  // computed as product.retail_price + SUM(each linked value's
  // price_adjustment) (see variantToDTO in products.service.js), not
  // stored redundantly here. Cost is NOT stored here either — unlike
  // selling price, cost naturally varies by what was actually purchased,
  // so it lives in CostLot (scoped by variant_id) exactly like batch
  // costing already works.
  price_override      Decimal?  @map("price_override")
  image_url           String?   @map("image_url")
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  product             Product        @relation(fields: [product_id], references: [id])
  // A variant's actual "Red, Medium" combination is the SET of rows here
  // — see ProductVariantValue below. Replaces the old single
  // variation_value_id FK, which could only ever hold one value.
  values              ProductVariantValue[]
  stock_levels        StockLevel[]
  stock_movements     StockMovement[]
  batches             Batch[]
  cost_lots           CostLot[]
  invoice_items       InvoiceItem[]
  transfers           StockTransfer[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, sku])
  @@index([business_id])
  @@map("product_variants")
}

// One row per (variant, value) pair — e.g. a "Red, Medium" variant has
// TWO rows here: one linking it to "Red" (under Color) and one linking
// it to "Medium" (under Size). This is what actually enables multi-axis
// variants: a ProductVariant is no longer tied to exactly one
// VariationValue, it's tied to however many its product's
// ProductVariationAxis rows call for.
//
// Note: Postgres can't express "no two variants of the same product may
// have the identical SET of values" as a single constraint on a join
// table like this — that's enforced in application code instead (see
// products.service.js#assertNoDuplicateVariantCombination), the same
// way roles.service.js checks role-name uniqueness before insert rather
// than only relying on the database to catch it.
model ProductVariantValue {
  id                  String   @id @default(uuid())
  variant_id          String   @map("variant_id")
  variation_value_id  String   @map("variation_value_id")

  variant             ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  variation_value     VariationValue @relation(fields: [variation_value_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([variant_id, variation_value_id])
  @@index([business_id])
  @@map("product_variant_values")
}

enum VariationValueType {
  TEXT
  MEASUREMENT
}

// A reusable variation TYPE, defined once and independent of any single
// product — e.g. "Color", "Diameter", "Length" — the same way a Category
// is defined once and then picked from a dropdown when adding a product,
// rather than being invented fresh on every product. Managed on its own
// Variations page, not inside the Add Product form. A product can use
// MULTIPLE Variations at once (Color AND Size) — see
// ProductVariationAxis on the Product model above.
model Variation {
  id          String    @id @default(uuid())
  name        String    
  // TEXT for values like colors/finishes; MEASUREMENT for values that are
  // really a number with a unit (Diameter: 2/4/6, unit "inch") — this
  // keeps those values sorting and displaying consistently instead of as
  // arbitrary free text (see `unit` below).
  value_type  VariationValueType @map("value_type") @default(TEXT)
  // Only meaningful when value_type = MEASUREMENT, e.g. "inch", "ft", "L".
  unit        String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  values        VariationValue[]
  product_axes  ProductVariationAxis[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, name])
  @@index([business_id])
  @@map("variations")
}

// One possible value under a Variation (e.g. "Red" under "Color") — also
// reusable across every product that attaches to that Variation. Carries
// its own default price add-on so an admin sets "6 inch costs +90" once,
// and every product/variant using 6 inch picks that up automatically
// (see ProductVariant.price_override above for the rare per-combination
// exception). A single variant can now combine price_adjustments from
// MULTIPLE values at once (see ProductVariantValue above) — e.g. "Red"
// +0 and "Medium" +0 and "Large" +200 all stack normally.
model VariationValue {
  id                     String    @id @default(uuid())
  variation_id           String    @map("variation_id")
  value                  String
  price_adjustment       Decimal   @map("price_adjustment") @default(0)
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  variation              Variation             @relation(fields: [variation_id], references: [id])
  product_variant_values ProductVariantValue[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([variation_id, value])
  @@map("variation_values")
}

// =====================================================
// KITS
// =====================================================

model Kit {
  id          String    @id @default(uuid())
  name        String
  sku         String    
  kit_price   Decimal   @map("kit_price")
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  components  KitComponent[]
  invoice_items InvoiceItem[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, sku])
  @@index([business_id])
  @@map("kits")
}

model KitComponent {
  id                   String    @id @default(uuid())
  kit_id               String    @map("kit_id")
  component_product_id String    @map("component_product_id")
  quantity             Decimal

  kit                  Kit       @relation(fields: [kit_id], references: [id])
  component_product    Product   @relation("ComponentProduct", fields: [component_product_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([kit_id, component_product_id])
  @@map("kit_components")
}

// =====================================================
// WAREHOUSE & INVENTORY
// =====================================================

model Warehouse {
  id          String    @id @default(uuid())
  name        String
  address     String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  stock_levels        StockLevel[]
  stock_movements     StockMovement[]
  from_transfers      StockTransfer[] @relation("FromWarehouse")
  to_transfers        StockTransfer[] @relation("ToWarehouse")
  invoices            Invoice[]
  purchase_orders     PurchaseOrder[]
  cost_lots           CostLot[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("warehouses")
}

model Batch {
  id            String    @id @default(uuid())
  product_id    String    @map("product_id")
  // Set only when the product is also variant-tracked (a color) — this
  // batch belongs to that specific color, not the product as a whole.
  // Null for products that are batch-tracked but not variant-tracked.
  variant_id    String?   @map("variant_id")
  batch_number  String    @map("batch_number")
  received_date DateTime  @map("received_date")
  created_at    DateTime  @default(now())

  product       Product         @relation(fields: [product_id], references: [id])
  variant       ProductVariant? @relation(fields: [variant_id], references: [id])
  stock_levels  StockLevel[]
  stock_movements StockMovement[]
  invoice_items  InvoiceItem[]
  transfers      StockTransfer[]
  cost_lots      CostLot[]

  // Uniqueness of batch_number is scoped by product + variant, but that
  // can't be expressed as a single DB-level unique index here: Postgres
  // treats every NULL as distinct in a unique index, so a compound key
  // including the nullable variant_id would silently stop enforcing
  // uniqueness for ordinary (non-variant) batch-tracked products, which
  // are the majority case — two colorless batches named "B1" would both
  // satisfy a [product_id, variant_id, batch_number] unique index because
  // their variant_id is NULL on both sides, and NULL never equals NULL.
  // So this is enforced in application code instead, the same pattern
  // already used for variant-combination uniqueness (see
  // products.service.js#assertNoDuplicateVariantCombination /
  // #assertBatchNumberAvailable) — checked explicitly before insert. Two
  // different variants of the same product are allowed to reuse the same
  // batch number (e.g. "B1" under Red and "B1" under Blue); the same
  // variant (or a non-variant product) may not reuse one already in use.
  // This plain index exists purely for lookup performance.
  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@index([product_id, variant_id])
  @@map("batches")
}

// FIFO costing. Every purchase creates a new lot at whatever it actually
// cost — stock is never blocked and never averaged into a blended price;
// the customer always sees one current selling price. A sale walks lots
// oldest-first (created_at asc) and consumes quantity_remaining until the
// sold quantity is covered, so a single sale can transparently draw from
// more than one lot (e.g. 8 units left in an old cheaper lot + 12 from a
// newer one) without ever showing the customer two prices. For
// batch-tracked products, lots are scoped to a specific batch_id (so cost
// is per-batch, as accurate as it gets); for everything else batch_id is
// null and lots are scoped to the product as a whole.
model CostLot {
  id                 String    @id @default(uuid())
  product_id         String    @map("product_id")
  // Set when the sold item is a specific color (variant-tracked product).
  variant_id         String?   @map("variant_id")
  batch_id           String?   @map("batch_id")
  warehouse_id       String    @map("warehouse_id")
  purchase_order_id  String?   @map("purchase_order_id")
  unit_cost          Decimal   @map("unit_cost")
  quantity_received  Decimal   @map("quantity_received")
  quantity_remaining Decimal   @map("quantity_remaining")
  created_at         DateTime  @default(now())

  product            Product        @relation(fields: [product_id], references: [id])
  variant            ProductVariant? @relation(fields: [variant_id], references: [id])
  batch              Batch?         @relation(fields: [batch_id], references: [id])
  warehouse          Warehouse      @relation(fields: [warehouse_id], references: [id])
  purchase_order     PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@index([product_id, variant_id, batch_id, created_at])
  @@map("cost_lots")
}

model StockLevel {
  id           String   @id @default(uuid())
  product_id   String   @map("product_id")
  variant_id   String?  @map("variant_id")
  batch_id     String?  @map("batch_id")
  warehouse_id String   @map("warehouse_id")
  quantity     Decimal

  product      Product         @relation(fields: [product_id], references: [id])
  variant      ProductVariant? @relation(fields: [variant_id], references: [id])
  batch        Batch?          @relation(fields: [batch_id], references: [id])
  warehouse    Warehouse       @relation(fields: [warehouse_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([product_id, variant_id, batch_id, warehouse_id])
  @@map("stock_levels")
}

model StockMovement {
  id                 String        @id @default(uuid())
  product_id         String        @map("product_id")
  variant_id         String?       @map("variant_id")
  batch_id           String?       @map("batch_id")
  warehouse_id       String        @map("warehouse_id")
  movement_type      MovementType
  quantity           Decimal
  reference_note     String?       @map("reference_note")
  invoice_id         String?       @map("invoice_id")
  purchase_order_id  String?       @map("purchase_order_id")
  stock_transfer_id  String?       @map("stock_transfer_id")
  created_at         DateTime      @default(now())
  created_by         String        @map("created_by")

  product            Product        @relation(fields: [product_id], references: [id])
  variant            ProductVariant? @relation(fields: [variant_id], references: [id])
  batch              Batch?        @relation(fields: [batch_id], references: [id])
  warehouse          Warehouse     @relation(fields: [warehouse_id], references: [id])
  invoice            Invoice?      @relation(fields: [invoice_id], references: [id])
  purchase_order     PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
  stock_transfer     StockTransfer? @relation(fields: [stock_transfer_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("stock_movements")
}

model StockTransfer {
  id                       String    @id @default(uuid())
  source_warehouse_id      String    @map("source_warehouse_id")
  destination_warehouse_id String    @map("destination_warehouse_id")
  product_id               String    @map("product_id")
  variant_id               String?   @map("variant_id")
  batch_id                 String?   @map("batch_id")
  quantity                 Decimal
  status                   String    @default("PENDING")
  requested_date           DateTime  @default(now())
  completed_date           DateTime? @map("completed_date")
  created_by               String    @map("created_by")

  source_warehouse         Warehouse @relation("FromWarehouse", fields: [source_warehouse_id], references: [id])
  destination_warehouse    Warehouse @relation("ToWarehouse", fields: [destination_warehouse_id], references: [id])
  product                  Product   @relation(fields: [product_id], references: [id])
  variant                  ProductVariant? @relation(fields: [variant_id], references: [id])
  batch                    Batch?    @relation(fields: [batch_id], references: [id])
  movements                StockMovement[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("stock_transfers")
}

// =====================================================
// CUSTOMERS
// =====================================================

model Customer {
  id            String    @id @default(uuid())
  name          String
  contact_phone String
  contact_email String?
  address       String?
  customer_type CustomerType @default(RETAIL)
  credit_limit  Decimal?  @map("credit_limit")
  gstin         String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  invoices      Invoice[]
  payments      Payment[]
  ledger_entries CustomerLedgerEntry[]
  installment_plans InstallmentPlan[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("customers")
}

model CustomerLedgerEntry {
  id          String   @id @default(uuid())
  customer_id String   @map("customer_id")
  entry_type  String
  amount      Decimal
  balance_after Decimal @map("balance_after")
  invoice_id  String?  @map("invoice_id")
  description String?
  created_at  DateTime @default(now())
  created_by  String   @map("created_by")

  customer    Customer @relation(fields: [customer_id], references: [id])
  invoice     Invoice? @relation(fields: [invoice_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("customer_ledger_entries")
}

// =====================================================
// INVOICES & SALES
// =====================================================

model Invoice {
  id             String         @id @default(uuid())
  invoice_number String          @map("invoice_number")
  customer_id    String         @map("customer_id")
  warehouse_id   String         @map("warehouse_id")
  subtotal       Decimal
  discount       Decimal        @default(0)
  cgst           Decimal        @default(0)
  sgst           Decimal        @default(0)
  igst           Decimal        @default(0)
  total_amount   Decimal        @map("total_amount")
  amount_paid    Decimal        @map("amount_paid") @default(0)
  balance_due    Decimal        @map("balance_due") @default(0)
  change_due     Decimal        @map("change_due") @default(0)
  payment_method PaymentMethod  @map("payment_method") @default(CASH)
  status         InvoiceStatus  @default(COMPLETED)
  // Set by the admin at checkout whenever balance_due > 0 — see the
  // CustomerCredit module (credit.service.js), which lists every invoice
  // still owing money past this date as overdue.
  due_date       DateTime?      @map("due_date")
  // SALE covers every normal transaction, including installment sales
  // (an installment plan just attaches to a SALE invoice — see
  // InstallmentPlan below). LATE_FEE is its own small invoice created
  // when a customer pays an overdue balance late — it never edits the
  // original SALE invoice's recorded total, it's a separate, dated
  // charge linked back via related_invoice_id, so historical totals
  // never silently change after the fact (see credit.service.js#chargeLateFee).
  invoice_type   InvoiceType    @map("invoice_type") @default(SALE)
  related_invoice_id String?    @map("related_invoice_id")
  created_by     String         @map("created_by")
  created_at     DateTime       @default(now())
  voided_at      DateTime?      @map("voided_at")
  voided_by      String?        @map("voided_by")
  void_reason    String?        @map("void_reason")

  customer       Customer       @relation(fields: [customer_id], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouse_id], references: [id])
  created_by_user User          @relation("CreatedByUser", fields: [created_by], references: [id])
  related_invoice Invoice?      @relation("LateFeeSource", fields: [related_invoice_id], references: [id])
  late_fees      Invoice[]      @relation("LateFeeSource")
  items          InvoiceItem[]
  payments       Payment[]
  stock_movements StockMovement[]
  ledger_entries CustomerLedgerEntry[]
  commissions    CommissionRecord[]
  installment_plan InstallmentPlan?

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, invoice_number])
  @@index([business_id])
  @@map("invoices")
}

enum InvoiceType {
  SALE
  LATE_FEE
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoice_id  String   @map("invoice_id")
  product_id  String?  @map("product_id")
  kit_id      String?  @map("kit_id")
  variant_id  String?  @map("variant_id")
  batch_id    String?  @map("batch_id")
  quantity    Decimal
  // Was `UomType` (a fixed enum). Now a plain string SNAPSHOT of the
  // unit's name/abbreviation at time of sale — not an FK to
  // UnitOfMeasure — for the same reason InstallmentPlan.min_down_payment_pct
  // freezes a copy rather than referencing BusinessSettings live: a unit
  // renamed or deleted after this sale must never rewrite a historical
  // invoice line.
  uom_used    String   @map("uom_used")
  unit_price  Decimal  @map("unit_price")
  // Discount actually applied to this line at time of sale — starts as
  // the product's standing discount but can be overridden per sale at
  // checkout. Frozen here so a later change to the product's default
  // discount never rewrites a past invoice.
  discount_type  DiscountType @map("discount_type") @default(PERCENTAGE)
  discount_value Decimal      @map("discount_value") @default(0)
  discount_amount Decimal     @map("discount_amount") @default(0)
  line_total  Decimal  @map("line_total")
  // Cost basis for this line, computed via FIFO lot consumption at sale
  // time (see sales.service.js#consumeCostLotsFifo) and frozen — margin
  // reports read this instead of recomputing from the product's *current*
  // cost, which may have moved since.
  cogs_amount Decimal  @map("cogs_amount") @default(0)

  invoice     Invoice  @relation(fields: [invoice_id], references: [id])
  product     Product? @relation(fields: [product_id], references: [id])
  kit         Kit?     @relation(fields: [kit_id], references: [id])
  variant     ProductVariant? @relation(fields: [variant_id], references: [id])
  batch       Batch?   @relation(fields: [batch_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("invoice_items")
}

model Payment {
  id          String         @id @default(uuid())
  invoice_id  String?        @map("invoice_id")
  customer_id String?        @map("customer_id")
  supplier_id String?        @map("supplier_id")
  // Set when this payment is settling one specific scheduled installment
  // (see InstallmentPayment below) rather than a free-form credit
  // payment against an invoice/customer balance in general.
  installment_payment_id String? @map("installment_payment_id")
  amount      Decimal
  method      PaymentMethod
  payment_date DateTime      @default(now())
  reference_no String?       @map("reference_no")
  // Snapshot of the invoice's remaining balance_due immediately after this
  // payment was applied — frozen at write time (same pattern as
  // CustomerLedgerEntry.balance_after) so the CustomerCredit "In Progress"
  // tab can show an accurate remaining-amount history per partial payment
  // without recomputing it from other rows. Null for payments not tied to
  // an invoice (e.g. a general supplier payment) and for older rows
  // recorded before this field existed unless backfilled — see migration
  // 20260729120000_payment_balance_after.
  balance_after Decimal?     @map("balance_after")
  // How much of `amount` was actually change handed back rather than
  // applied to the invoice's balance — set when a credit payment (see
  // CreditService#recordPayment) is tendered for more than what's still
  // due, mirroring Invoice.change_due at checkout. `amount` above is
  // always the portion actually applied to the balance, so
  // balance_after = balance_before - amount still holds regardless of
  // this field. 0 for every payment that didn't overpay, and for
  // installment payments (which are pre-agreed exact amounts).
  change_due  Decimal        @default(0) @map("change_due")
  created_by  String         @map("created_by")

  invoice     Invoice?       @relation(fields: [invoice_id], references: [id])
  customer    Customer?      @relation(fields: [customer_id], references: [id])
  supplier    Supplier?      @relation(fields: [supplier_id], references: [id])
  installment_payment InstallmentPayment? @relation(fields: [installment_payment_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("payments")
}

// =====================================================
// INSTALLMENTS
// =====================================================

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

// Attaches to a normal SALE invoice (see Invoice.installment_plan above)
// — stock deduction, reports, etc. all already work off that invoice
// untouched. This only adds a schedule for how the (marked-up) total
// gets paid over time. total_amount here always matches the invoice's
// total_amount at creation — kept as its own field so the plan reads
// standalone without always joining back to the invoice.
model InstallmentPlan {
  id                    String    @id @default(uuid())
  invoice_id            String    @unique @map("invoice_id")
  customer_id           String    @map("customer_id")
  total_amount          Decimal   @map("total_amount")
  down_payment          Decimal   @map("down_payment")
  // The minimum down-payment % in effect when this plan was created —
  // frozen here (not just read live from Settings) so a later change to
  // the required minimum never reinterprets a plan that was already
  // agreed to under the old rule.
  min_down_payment_pct  Decimal   @map("min_down_payment_pct")
  installment_count     Int       @map("installment_count")
  installment_amount    Decimal   @map("installment_amount")
  frequency_days        Int       @map("frequency_days") @default(30)
  status                InstallmentPlanStatus @default(ACTIVE)
  created_at            DateTime  @default(now())
  created_by            String    @map("created_by")

  invoice               Invoice   @relation(fields: [invoice_id], references: [id])
  customer              Customer  @relation(fields: [customer_id], references: [id])
  installments          InstallmentPayment[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("installment_plans")
}

model InstallmentPayment {
  id          String    @id @default(uuid())
  plan_id     String    @map("plan_id")
  sequence    Int
  amount      Decimal
  due_date    DateTime  @map("due_date")
  paid_date   DateTime? @map("paid_date")
  status      PaidStatus @default(PENDING)

  plan        InstallmentPlan @relation(fields: [plan_id], references: [id])
  payments    Payment[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([plan_id, sequence])
  @@map("installment_payments")
}

// =====================================================
// SUPPLIERS & PURCHASE
// =====================================================

model Supplier {
  id            String    @id @default(uuid())
  name          String
  contact_phone String
  contact_email String?
  address       String?
  payment_terms String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  purchase_orders PurchaseOrder[]
  payments        Payment[]
  ledger_entries  SupplierLedgerEntry[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("suppliers")
}

model SupplierLedgerEntry {
  id               String   @id @default(uuid())
  supplier_id      String   @map("supplier_id")
  entry_type       String
  amount           Decimal
  balance_after    Decimal  @map("balance_after")
  purchase_order_id String? @map("purchase_order_id")
  description      String?
  created_at       DateTime @default(now())
  created_by       String   @map("created_by")

  supplier         Supplier @relation(fields: [supplier_id], references: [id])
  purchase_order   PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("supplier_ledger_entries")
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  po_number        String     @map("po_number")
  supplier_id      String    @map("supplier_id")
  warehouse_id     String    @map("warehouse_id")
  status           PurchaseOrderStatus @default(DRAFT)
  order_date       DateTime  @default(now())
  expected_delivery DateTime? @map("expected_delivery")
  received_date    DateTime? @map("received_date")
  created_by       String    @map("created_by")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  supplier         Supplier  @relation(fields: [supplier_id], references: [id])
  warehouse        Warehouse @relation(fields: [warehouse_id], references: [id])
  items            PurchaseOrderItem[]
  stock_movements  StockMovement[]
  ledger_entries   SupplierLedgerEntry[]
  cost_lots        CostLot[]

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@unique([business_id, po_number])
  @@index([business_id])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String    @id @default(uuid())
  purchase_order_id String    @map("purchase_order_id")
  product_id        String    @map("product_id")
  quantity_ordered  Decimal   @map("quantity_ordered")
  quantity_received Decimal   @map("quantity_received") @default(0)
  unit_cost         Decimal   @map("unit_cost")
  batch_number      String?   @map("batch_number")

  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  product           Product    @relation(fields: [product_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("purchase_order_items")
}

// =====================================================
// EMPLOYEES & PAYROLL
// =====================================================

model Employee {
  id              String   @id @default(uuid())
  user_id         String?  @unique @map("user_id")
  // Kept alongside User.name (not replaced by it) because an Employee can
  // exist with no login account at all (payroll-only staff) — when
  // user_id IS set, the Profile module keeps this in sync with
  // User.name whenever either is edited, so they never drift apart in
  // practice; see profile.service.js#updateProfile.
  name            String
  role_title      String   @map("role_title")
  contact_phone   String?  @map("contact_phone")
  address         String?
  base_salary     Decimal  @map("base_salary")
  commission_rate Decimal? @map("commission_rate")
  is_active       Boolean  @default(true)
  hire_date       DateTime @map("hire_date") @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User?    @relation(fields: [user_id], references: [id])
  payroll_records PayrollRecord[]
  commissions     CommissionRecord[]
  staff_expenses  StaffExpense[]
  expense_limit   StaffExpenseLimit?

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("employees")
}

model PayrollRecord {
  id                String     @id @default(uuid())
  employee_id       String     @map("employee_id")
  period_start      DateTime   @map("period_start")
  period_end        DateTime   @map("period_end")
  base_salary_amount Decimal    @map("base_salary_amount")
  commission_amount Decimal    @map("commission_amount") @default(0)
  total_payable     Decimal    @map("total_payable")
  paid_status       PaidStatus @default(PENDING)
  paid_date         DateTime?  @map("paid_date")
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  created_by        String     @map("created_by")

  employee          Employee   @relation(fields: [employee_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("payroll_records")
}

model CommissionRecord {
  id               String   @id @default(uuid())
  employee_id      String   @map("employee_id")
  invoice_id       String   @map("invoice_id")
  sale_amount      Decimal  @map("sale_amount")
  commission_rate  Decimal  @map("commission_rate")
  commission_amount Decimal  @map("commission_amount")
  created_at       DateTime @default(now())

  employee         Employee @relation(fields: [employee_id], references: [id])
  invoice          Invoice  @relation(fields: [invoice_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@unique([invoice_id, employee_id])
  @@map("commission_records")
}

// =====================================================
// SETTINGS
// =====================================================

// One row per business now, instead of a single fixed-id row (see
// settings.service.js, which used to always read/create id
// "business_settings" — it now reads/creates by business_id instead).
// Everything here is optional at the schema level since a brand-new
// business has none of it filled in yet.
model BusinessSettings {
  id                     String   @id @default(uuid())
  business_id            String   @unique @map("business_id")
  company_name           String?  @map("company_name")
  logo_url               String?  @map("logo_url")
  address                String?
  phone                  String?
  tax_id                 String?  @map("tax_id")
  invoice_footer_note    String?  @map("invoice_footer_note")
  currency_symbol        String   @map("currency_symbol") @default("₹")
  default_tax_rate       Decimal  @map("default_tax_rate") @default(0)
  invoice_number_prefix  String   @map("invoice_number_prefix") @default("INV-")
  // Installments module — see InstallmentPlan.min_down_payment_pct,
  // which freezes a copy of this value at plan-creation time.
  min_down_payment_pct   Decimal  @map("min_down_payment_pct") @default(20)
  low_stock_alerts       Boolean  @map("low_stock_alerts") @default(true)
  overdue_credit_alerts  Boolean  @map("overdue_credit_alerts") @default(true)
  session_timeout_minutes Int     @map("session_timeout_minutes") @default(60)
  updated_at             DateTime @updatedAt
  updated_by             String?  @map("updated_by")

  business               Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("business_settings")
}


// =====================================================
// STAFF EXPENSE MANAGEMENT
// =====================================================
// Independent from Payroll — this tracks discretionary staff spend
// against a shared, admin-set budget pool (e.g. "buy lunch, Rs 400"),
// not salary. See backend/src/modules/expenses/*.

enum ExpenseStatus {
  RECORDED
  VOIDED
}

// One row per business now, same pattern change as BusinessSettings
// above (get-or-created lazily by ExpensesService#getBudget, keyed by
// business_id instead of a fixed id). total_amount / current_balance are
// both manually editable by an admin (EXPENSES_MANAGE); default_max_per_
// expense is the fallback per-expense cap applied to any staff member
// who doesn't have their own row in StaffExpenseLimit below.
model ExpenseBudget {
  id                      String   @id @default(uuid())
  business_id             String   @unique @map("business_id")
  total_amount            Decimal  @map("total_amount") @default(0)
  current_balance         Decimal  @map("current_balance") @default(0)
  default_max_per_expense Decimal  @map("default_max_per_expense") @default(1000)
  updated_at              DateTime @updatedAt
  updated_by              String?  @map("updated_by")

  business                Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  adjustments             ExpenseBudgetAdjustment[]

  @@map("expense_budgets")
}

// One row per manual change to the budget's total_amount — an audit
// trail separate from the budget row itself (which only ever holds the
// *current* state). See ExpensesService#setBudget.
model ExpenseBudgetAdjustment {
  id             String   @id @default(uuid())
  budget_id      String   @map("budget_id")
  previous_total Decimal  @map("previous_total")
  new_total      Decimal  @map("new_total")
  difference     Decimal
  reason         String?
  adjusted_by    String   @map("adjusted_by")
  created_at     DateTime @default(now())

  budget         ExpenseBudget @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("expense_budget_adjustments")
}

// Per-employee override of ExpenseBudget.default_max_per_expense. No row
// for a given employee = they use the current default. Editable by an
// admin per staff member (see ExpensesService#setLimit).
model StaffExpenseLimit {
  id          String   @id @default(uuid())
  employee_id String   @unique @map("employee_id")
  max_amount  Decimal  @map("max_amount")
  updated_at  DateTime @updatedAt
  updated_by  String?  @map("updated_by")

  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@map("staff_expense_limits")
}

// One row per recorded (or voided) staff expense. balance_after freezes
// what the budget's current_balance was immediately after this expense
// was deducted, so the history reads as a real ledger, not just a list
// of amounts.
//
// Voiding (see ExpensesService#voidExpense) never deletes a row; it
// flips status to VOIDED and refunds the amount back into the budget,
// mirroring how Invoice/StockMovement handle reversals elsewhere in
// this schema.
model StaffExpense {
  id            String        @id @default(uuid())
  employee_id   String        @map("employee_id")
  amount        Decimal
  category      String?
  description   String?
  expense_date  DateTime      @default(now()) @map("expense_date")
  balance_after Decimal       @map("balance_after")
  status        ExpenseStatus @default(RECORDED)
  voided_at     DateTime?     @map("voided_at")
  voided_by     String?       @map("voided_by")
  void_reason   String?       @map("void_reason")
  created_by    String        @map("created_by")
  created_at    DateTime      @default(now())

  employee      Employee      @relation(fields: [employee_id], references: [id])

  business_id String   @map("business_id")
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  @@index([business_id])
  @@index([employee_id, expense_date])
  @@index([expense_date])
  @@map("staff_expenses")
}


