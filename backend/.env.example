# Database connection
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pos_inventory_db"

# JWT Secret
JWT_SECRET="replace-with-a-long-random-string"

# Server port
PORT=5000

# Directory (relative to backend/) where uploaded product images are stored
UPLOAD_DIR=uploads

NODE_ENV=development

# Root domain for subdomain-based tenant resolution (see src/middleware/tenantMiddleware.js).
# "localhost" here means "businessname.localhost" is treated as tenant "businessname" during local dev.
# In production, change this to your registered root domain (e.g. "pos.com").
APP_DOMAIN=localhost

# Subdomain reserved exclusively for the Platform Admin portal.
# The tenant middleware will never treat this as a business slug.
# Must match VITE_PLATFORM_SUBDOMAIN in frontend/.env.
# Local dev: http://deeplexica.localhost:5173/platform/login
# Production: https://deeplexica.pos.com/platform/login
PLATFORM_SUBDOMAIN=deeplexica
